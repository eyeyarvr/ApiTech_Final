<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/ice">
    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:background="@color/white" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="14dp" android:elevation="2dp">
        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:padding="6dp" android:background="@drawable/bg_circle_green" android:src="@drawable/ic_leaf" android:tint="@android:color/white" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="ApiTech" android:fontFamily="serif" android:textColor="@color/evergreen" android:textSize="24sp" />
        <ImageView android:id="@+id/btnSearchTop" android:layout_width="38dp" android:layout_height="38dp" android:padding="9dp" android:background="@drawable/bg_circle_ice" android:src="@drawable/ic_search" />
        <ImageView android:id="@+id/btnBell" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="8dp" android:padding="9dp" android:background="@drawable/bg_circle_ice" android:src="@drawable/ic_bell" />
        <FrameLayout android:id="@+id/btnCart" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="6dp">
            <ImageView android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="center" android:padding="9dp" android:background="@drawable/bg_circle_green" android:src="@drawable/ic_bag" android:tint="@android:color/white" />
            <TextView android:id="@+id/tvCartBadge" android:layout_width="wrap_content" android:layout_height="17dp" android:minWidth="17dp" android:layout_gravity="top|end" android:background="@drawable/bg_circle_peony" android:gravity="center" android:textSize="9sp" android:textStyle="bold" android:textColor="@color/evergreen" />
        </FrameLayout>
        <TextView android:id="@+id/avatar" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="4dp" android:background="@drawable/bg_circle_peony" android:gravity="center" android:textStyle="bold" android:textColor="@color/evergreen" />
    </LinearLayout>
    <FrameLayout android:id="@+id/shellContent" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottomNav" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/white" app:itemIconTint="@color/evergreen" app:itemTextColor="@color/evergreen" />
</LinearLayout>
