<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:orientation="vertical" android:padding="12dp" android:background="@drawable/bg_input">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:id="@+id/ivListing" android:layout_width="44dp" android:layout_height="44dp" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/tvListingName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textColor="@color/ink" />
            <TextView android:id="@+id/tvListingAgo" style="@style/Body" android:textSize="11sp" />
        </LinearLayout>
        <TextView android:id="@+id/tvListingBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:textSize="10sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/tvPriceLabel" style="@style/Label" />
    <EditText android:id="@+id/etListingPrice" style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
    <TextView style="@style/Label" android:text="Stock available" />
    <EditText android:id="@+id/etListingStock" style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
    <TextView style="@style/Label" android:text="Listing status" />
    <Spinner android:id="@+id/spListingStatus" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_card" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnListingDelete" style="@style/Btn.Soft" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:text="Delete" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnListingSave" style="@style/Btn.Primary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="Save changes" />
    </LinearLayout>
</LinearLayout>
