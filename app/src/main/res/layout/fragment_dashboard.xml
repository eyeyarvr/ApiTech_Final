<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <TextView style="@style/Eyebrow" android:text="YOUR FARM AT A GLANCE" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="5dp" android:orientation="vertical" android:padding="14dp" android:background="@drawable/bg_card">
            <TextView style="@style/Body" android:text="TODAY’S ORDERS" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvOrdersToday" style="@style/H2" android:text="0" android:textSize="28sp" />
            <TextView android:id="@+id/tvOrdersDelta" style="@style/Body" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:orientation="vertical" android:padding="14dp" android:background="@drawable/bg_card">
            <TextView style="@style/Body" android:text="ITEMS IN STOCK" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvStockTotal" style="@style/H2" android:text="0" android:textSize="28sp" />
            <TextView android:id="@+id/tvListings" style="@style/Body" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:orientation="vertical" android:padding="14dp" android:background="@drawable/bg_card">
            <TextView style="@style/Body" android:text="TODAY’S SALES" android:textSize="9sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvSalesToday" style="@style/H2" android:text="₱0" android:textSize="22sp" />
            <TextView android:id="@+id/tvSalesWeek" style="@style/Body" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- forecast -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_card">
        <TextView style="@style/Eyebrow" android:text="LIVE CROP FORECAST" />
        <TextView android:id="@+id/tvForecastTitle" style="@style/H2" android:layout_marginTop="4dp" />
        <EditText android:id="@+id/etCropSearch" style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Search vegetables..." android:drawableStart="@drawable/ic_search" android:drawablePadding="8dp" android:singleLine="true" />
        <TextView style="@style/Label" android:text="View crop" />
        <Spinner android:id="@+id/spCrop" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_input" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="bottom">
            <TextView android:id="@+id/tvPrice" style="@style/H1" android:textSize="34sp" />
            <TextView style="@style/Body" android:layout_marginStart="6dp" android:layout_marginBottom="6dp" android:text="per kg" />
            <TextView android:id="@+id/tvChange" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_marginBottom="6dp" android:textStyle="bold" android:textSize="12sp" />
        </LinearLayout>
        <com.apitech.ani.PriceChartView android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginTop="10dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp">
            <TextView style="@style/Body" android:layout_width="0dp" android:layout_weight="1" android:text="Mon" android:textSize="10sp" />
            <TextView style="@style/Body" android:layout_width="0dp" android:layout_weight="1" android:text="Tue" android:textSize="10sp" />
            <TextView style="@style/Body" android:layout_width="0dp" android:layout_weight="1" android:text="Wed" android:textSize="10sp" />
            <TextView style="@style/Body" android:layout_width="0dp" android:layout_weight="1" android:text="Thu" android:textSize="10sp" />
            <TextView style="@style/Body" android:layout_width="0dp" android:layout_weight="1" android:text="Fri" android:textSize="10sp" />
            <TextView style="@style/Body" android:layout_width="0dp" android:layout_weight="1" android:text="Sat" android:textSize="10sp" />
            <TextView style="@style/Body" android:layout_width="0dp" android:layout_weight="1" android:gravity="end" android:text="Today" android:textSize="10sp" />
        </LinearLayout>
        <TextView android:id="@+id/tvInsight" style="@style/Body" android:layout_marginTop="12dp" android:textSize="13sp" />
    </LinearLayout>

    <!-- inventory -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_card">
        <TextView style="@style/Eyebrow" android:text="MY INVENTORY" />
        <TextView style="@style/H2" android:layout_marginTop="4dp" android:text="Today’s stock" />
        <LinearLayout android:id="@+id/stockList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <LinearLayout android:id="@+id/lowStockBox" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:padding="12dp" android:background="@drawable/bg_peony">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_bell" />
            <TextView android:id="@+id/tvLowStock" style="@style/Body" android:layout_marginStart="10dp" android:textSize="13sp" android:textColor="@color/ink" />
        </LinearLayout>
    </LinearLayout>

    <!-- supply sources -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_card">
        <TextView style="@style/Eyebrow" android:text="LOCAL NETWORK" />
        <TextView style="@style/H2" android:layout_marginTop="4dp" android:text="Supply sources" />
        <TextView style="@style/Body" android:layout_marginTop="6dp" android:text="Where this week’s marketplace supply is coming from. (Benguet only)" />
        <LinearLayout android:id="@+id/barList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>

    <!-- seeds -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_card">
        <TextView style="@style/Eyebrow" android:text="FARMER SEED MARKETPLACE" />
        <TextView style="@style/H2" android:layout_marginTop="4dp" android:text="Buy or sell quality seeds" />
        <TextView style="@style/Body" android:layout_marginTop="6dp" android:text="Offer extra seeds to nearby farmers or find trusted varieties for your next season." />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnSellSeeds" style="@style/Btn.Soft" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="＋  Sell your seeds" />
        <LinearLayout android:id="@+id/seedForm" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView style="@style/Label" android:text="Seed or variety name" />
            <EditText android:id="@+id/etSeedName" style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView style="@style/Label" android:text="Pack size" />
            <EditText android:id="@+id/etSeedPack" style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="e.g. 250g" />
            <TextView style="@style/Label" android:text="Price per pack" />
            <EditText android:id="@+id/etSeedPrice" style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
            <TextView style="@style/Label" android:text="Available packs" />
            <EditText android:id="@+id/etSeedPacks" style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
            <TextView style="@style/Label" android:text="Pickup location" />
            <Spinner android:id="@+id/spSeedLocation" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_input" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnPostSeeds" style="@style/Btn.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Post seeds for sale" />
        </LinearLayout>
        <TextView android:id="@+id/tvSeedCount" style="@style/Label" android:layout_marginTop="16dp" android:textSize="14sp" android:textColor="@color/ink" />
        <LinearLayout android:id="@+id/seedList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        
    </LinearLayout>
</LinearLayout>
</ScrollView>
