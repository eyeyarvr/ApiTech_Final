<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingTop="6dp" android:paddingBottom="6dp">
    <ImageView android:layout_width="42dp" android:layout_height="42dp" android:padding="10dp" android:background="@drawable/bg_circle_peony" android:src="@drawable/ic_seed" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:id="@+id/tvSeedName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textColor="@color/ink" />
        <TextView android:id="@+id/tvSeedMeta" style="@style/Body" android:textSize="11sp" />
    </LinearLayout>
    <TextView android:id="@+id/tvSeedPrice" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textColor="@color/evergreen" />
</LinearLayout>
