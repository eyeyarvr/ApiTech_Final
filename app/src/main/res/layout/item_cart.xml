<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:padding="12dp" android:gravity="center_vertical" android:background="@drawable/bg_card">
    <ImageView android:id="@+id/ivCart" android:layout_width="64dp" android:layout_height="64dp" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:id="@+id/tvCartName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textColor="@color/ink" />
        <TextView android:id="@+id/tvCartMeta" style="@style/Body" android:textSize="11sp" />
        <TextView android:id="@+id/tvCartLine" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textStyle="bold" android:textColor="@color/evergreen" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:background="@drawable/bg_input">
            <TextView android:id="@+id/btnMinus" android:layout_width="36dp" android:layout_height="34dp" android:gravity="center" android:text="−" android:textSize="18sp" android:textColor="@color/evergreen" />
            <TextView android:id="@+id/tvQty" android:layout_width="28dp" android:layout_height="wrap_content" android:gravity="center" android:textStyle="bold" android:textColor="@color/ink" />
            <TextView android:id="@+id/btnPlus" android:layout_width="36dp" android:layout_height="34dp" android:gravity="center" android:text="+" android:textSize="18sp" android:textColor="@color/evergreen" />
        </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/btnRemove" android:layout_width="32dp" android:layout_height="32dp" android:padding="7dp" android:src="@drawable/ic_close" />
</LinearLayout>
