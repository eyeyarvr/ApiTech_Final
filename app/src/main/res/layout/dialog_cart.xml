<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/white">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:gravity="center_vertical">
        <TextView style="@style/H1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Your basket" />
        <ImageView android:id="@+id/btnClose" android:layout_width="38dp" android:layout_height="38dp" android:padding="9dp" android:background="@drawable/bg_circle_ice" android:src="@drawable/ic_close" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/cartList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" />
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:background="@color/ice">
        <TextView style="@style/Eyebrow" android:text="DELIVER TO" />
        <TextView android:id="@+id/tvAddress" style="@style/Body" android:layout_marginTop="4dp" android:textColor="@color/ink" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Total" android:textStyle="bold" android:textColor="@color/ink" />
            <TextView android:id="@+id/tvTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="18sp" android:textColor="@color/evergreen" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnCheckout" style="@style/Btn.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Place order" />
    </LinearLayout>
</LinearLayout>
