<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/white">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

    <FrameLayout android:layout_width="match_parent" android:layout_height="300dp">
        <ImageView android:id="@+id/heroImage" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_welcome_overlay" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="22dp" android:gravity="center_vertical">
            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:padding="5dp" android:background="@drawable/bg_circle_green" android:src="@drawable/ic_leaf" android:tint="@android:color/white" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="ApiTech" android:fontFamily="serif" android:textColor="@android:color/white" android:textSize="24sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:padding="22dp">
            <TextView style="@style/Eyebrow" android:text="WELCOME!" android:textColor="#e9f1e5" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Good food begins with knowing who grew it." android:fontFamily="serif" android:textColor="@android:color/white" android:textSize="30sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="8dp" android:text="Photo by Shelley Pauls on Unsplash" android:textColor="#99FFFFFF" android:textSize="9sp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp">

        <!-- intro -->
        <LinearLayout android:id="@+id/introCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnCreate" style="@style/Btn.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Create your account  →" />
            <TextView style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center" android:text="OR EXPLORE THE DEMO" android:textSize="11sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnDemoCustomer" style="@style/Btn.Soft" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="5dp" android:text="Enter as customer" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnDemoFarmer" style="@style/Btn.Soft" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:text="Enter as farmer" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="22dp" android:gravity="center_vertical">
                <TextView style="@style/Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Already have an account?" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnGoLogin" style="@style/Btn.Link" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Log in" />
            </LinearLayout>
        </LinearLayout>

        <!-- sign up -->
        <LinearLayout android:id="@+id/signupCard" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnBackSignup" style="@style/Btn.Link" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="← Back" />
            <TextView android:id="@+id/tvStep" style="@style/Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="STEP 1 OF 2" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvSignupTitle" style="@style/H1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Tell us about you" />
            <TextView android:id="@+id/tvSignupLead" style="@style/Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="A few details will help us make your local market feel personal." />

            <LinearLayout android:id="@+id/step1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Full name" />
                <EditText android:id="@+id/etName" style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" />
                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Username" />
                <EditText android:id="@+id/etUsername" style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" />
                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Email address" />
                <EditText android:id="@+id/etEmail" style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" />
                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Contact number" />
                <EditText android:id="@+id/etPhone" style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" />
                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Location" />
                <Spinner android:id="@+id/spCity" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_input" />
                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Complete address" />
                <EditText android:id="@+id/etAddress" style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPostalAddress" />
                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Password" />
                <EditText android:id="@+id/etPassword" style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" />
            </LinearLayout>

            <LinearLayout android:id="@+id/step2" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/roleCustomer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:padding="16dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/bg_option_selected">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/bg_circle_peony" android:src="@drawable/ic_bag" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="I’m here to shop" android:textStyle="bold" android:textColor="@color/ink" />
                        <TextView style="@style/Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Find fresh crops from nearby growers" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/roleFarmer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="16dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/bg_option">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/bg_circle_peony" android:src="@drawable/ic_seed" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="I grow or sell produce" android:textStyle="bold" android:textColor="@color/ink" />
                        <TextView style="@style/Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Share my harvest and manage my business" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/farmerQuestion" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:padding="15dp" android:orientation="vertical" android:background="@drawable/bg_peony">
                    <TextView style="@style/Eyebrow" android:text="TELL US ABOUT YOUR FARM" />
                    <TextView style="@style/H2" android:layout_marginTop="4dp" android:text="What do you grow or sell?" android:textSize="19sp" />
                    <EditText style="@style/Input" android:layout_width="match_parent" android:layout_height="80dp" android:layout_marginTop="8dp" android:gravity="top" android:inputType="textMultiLine" />
                </LinearLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnContinue" style="@style/Btn.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Continue  →" />
            <TextView style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="By continuing, you agree to ApiTech Terms and Privacy Policy." android:textSize="10sp" />
        </LinearLayout>

        <!-- login -->
        <LinearLayout android:id="@+id/loginCard" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnBackLogin" style="@style/Btn.Link" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="← Back" />
            <TextView style="@style/Eyebrow" android:layout_marginTop="10dp" android:text="WELCOME BACK" />
            <TextView style="@style/H1" android:layout_marginTop="6dp" android:text="Log in to ApiTech" />
            <TextView style="@style/Body" android:layout_marginTop="6dp" android:text="Enter your account details to continue to your local marketplace." />
            <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Email address" />
            <EditText android:id="@+id/etLoginEmail" style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" />
            <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Password" />
            <EditText android:id="@+id/etLoginPassword" style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical">
                <CheckBox android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Remember me" android:textSize="12sp" android:buttonTint="@color/evergreen" />
                <androidx.appcompat.widget.AppCompatButton style="@style/Btn.Link" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Forgot password?" android:textSize="12sp" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnLogin" style="@style/Btn.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Log in  →" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="18dp" android:gravity="center_vertical">
                <TextView style="@style/Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="New to ApiTech?" />
                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnGoSignup" style="@style/Btn.Link" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Create an account" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
</ScrollView>
